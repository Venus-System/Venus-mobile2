<?xml version="1.0" encoding="utf-8"?>
<!-- Opcao do questionario. O state_selected marca a escolhida sem
     precisar de codigo trocando drawable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="2dp"
                android:color="@color/roxo_venus" />
            <corners android:radius="@dimen/raio_pilula" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke
                android:width="1dp"
                android:color="@color/borda_campo" />
            <corners android:radius="@dimen/raio_pilula" />
        </shape>
    </item>

</selector>
