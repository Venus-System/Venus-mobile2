<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">

    <item>
        <shape android:shape="rectangle">

            <gradient
                android:angle="0"
                android:startColor="#FF5B0FA8"
                android:endColor="#FF8C1556"
                android:type="linear" />

            <stroke
                android:width="1.5dp"
                android:color="@color/white" />

            <corners android:radius="@dimen/raio_pilula" />

        </shape>
    </item>

</ripple>
